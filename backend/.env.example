PORT=4000

# SMTP credentials for sending contact form emails.
# If left unset, the server falls back to a temporary Ethereal test inbox
# (emails aren't really delivered, but a preview URL is logged to the console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where contact form submissions should be delivered, and the "from" address.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
